# Production-окружение EduQuiz. Скопируй в .env.prod, подставь реальные значения,
# не коммить в git (.env* исключены через .gitignore).
#
# Использование:
#   cp .env.prod.example .env.prod
#   nano .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- API ---
HTTP_ADDR=:8080
ENV=production

# Сгенерируй: openssl rand -base64 32
JWT_SECRET=replace-me-with-strong-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- PostgreSQL ---
POSTGRES_USER=eduquiz
POSTGRES_DB=eduquiz
# Сгенерируй: openssl rand -base64 24
POSTGRES_PASSWORD=replace-me-with-strong-password

# DATABASE_URL строится автоматически в docker-compose.prod.yml из POSTGRES_*.
# REDIS_URL фиксирован: redis://redis:6379/0 (внутри docker-сети).

# --- Caddy / TLS ---
# Домен, на который выписывается Let's Encrypt сертификат. Должна быть A/AAAA-запись на IP VPS.
DOMAIN=eduquiz.example.ru

# --- Образ API ---
# По умолчанию — pre-built из GHCR. Можно зафиксировать тег (например, v0.3.0).
API_IMAGE=ghcr.io/vladislavgithub/eduquiz-api:latest
