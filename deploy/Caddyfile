# Caddyfile для production-стека EduQuiz.
# Auto-TLS via Let's Encrypt. Домен берётся из переменной окружения DOMAIN.
#
# Маршрутизация:
#   /api/*    → api:8080  (REST)
#   /ws/*     → api:8080  (WebSocket)
#   /healthz, /readyz → api:8080  (служебные)
#   /*        → /srv/web  (Flutter Web SPA, fallback на index.html)

{
	email admin@eduquizz.ru
	servers {
		protocols h1 h2 h3
	}
}

eduquizz.ru {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	handle /ws/* {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}

	handle /files/* {
		uri strip_prefix /files
		root * /srv/uploads
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
